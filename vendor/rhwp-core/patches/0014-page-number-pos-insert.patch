+/// 기존 앱의 (구역, 모양, 위치, 줄표) 인수 순서와 JSON 계약을 지킨다.
+#[test]
+fn legacy_page_number_pos_api_keeps_argument_order_and_json_shape() {
+    let mut doc = HwpDocument::create_empty();
+    doc.create_blank_document_native().unwrap();
+    doc.insert_text_native(0, 0, 0, "가나다 라마바").unwrap();
+    let read = |doc: &HwpDocument| -> Value {
+        serde_json::from_str(&doc.get_page_number_pos_native(0).unwrap()).unwrap()
+    };
+    assert_eq!(read(&doc), serde_json::json!({"ok":true,"pageNumber":null}));
+    let inserted: Value =
+        serde_json::from_str(&doc.set_page_number_pos_native(0, 2, 5, false).unwrap()).unwrap();
+    assert_eq!(inserted, serde_json::json!({"ok":true,"replaced":false}));
+    assert_eq!(
+        read(&doc),
+        serde_json::json!({
+            "ok":true,"pageNumber":{"format":2,"position":5,"dash":false}
+        })
+    );
+    for bytes in [
+        doc.export_hwp_with_adapter().unwrap(),
+        doc.export_hwpx_native().unwrap(),
+    ] {
+        let again = HwpDocument::new(&bytes).unwrap();
+        assert_eq!(read(&again), read(&doc), "HWP/HWPX에서 줄표 없음 보존");
+        assert_eq!(
+            again.get_text_range_native(0, 0, 0, 7).unwrap(),
+            "가나다 라마바"
+        );
+    }
+    let replaced: Value =
+        serde_json::from_str(&doc.set_page_number_pos_native(0, 1, 6, true).unwrap()).unwrap();
+    assert_eq!(replaced, serde_json::json!({"ok":true,"replaced":true}));
+    assert_eq!(
+        read(&doc),
+        serde_json::json!({
+            "ok":true,"pageNumber":{"format":1,"position":6,"dash":true}
+        })
+    );
+    let current: Value =
+        serde_json::from_str(&doc.get_page_number_position_native(0).unwrap()).unwrap();
+    assert_eq!(
+        current,
+        serde_json::json!({"ok":true,"exists":true,"position":6,"format":1,"dash":true})
+    );
+    assert!(doc.set_page_number_pos_native(0, 8, 5, true).is_err());
+    assert!(doc.set_page_number_pos_native(0, 0, 11, true).is_err());
+    assert!(doc.set_page_number_pos_native(3, 0, 5, true).is_err());
+    assert!(doc.get_page_number_pos_native(3).is_err());
+    assert_eq!(
+        read(&doc)["pageNumber"]["position"],
+        6,
+        "잘못된 입력은 문서를 바꾸지 않는다"
+    );
+}
