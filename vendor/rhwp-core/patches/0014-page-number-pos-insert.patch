From: ttokttak maintainers
Subject: [PATCH 14] Keep legacy page-number API alongside upstream Position API

Apply after 0013 on rhwp-core v0.9.0. Upstream already implements page-number
insertion/replacement and empty sideChar parsing/serialization. Keep it and
adapt legacy setPageNumberPos(section, format, position, dash), the 0..7
format limit, and {ok,replaced}/{ok,pageNumber} response shapes. The legacy setter updates an existing control in place so table cursor
addresses remain valid; only insertion delegates to upstream. Both getters
use its last-control semantics.
No parser/serializer or object_ops changes are needed.

diff --git a/src/document_core/commands/formatting.rs b/src/document_core/commands/formatting.rs
--- a/src/document_core/commands/formatting.rs
+++ b/src/document_core/commands/formatting.rs
@@ -2961,6 +2961,69 @@
         Ok("{\"ok\":true,\"exists\":false}".to_string())
     }

+    /// Legacy page-number API preserves existing control addresses for the app cursor.
+    pub fn set_page_number_pos_native(
+        &mut self,
+        section_idx: usize,
+        format: u8,
+        position: u8,
+        dash: bool,
+    ) -> Result<String, HwpError> {
+        if format > 7 {
+            return Err(HwpError::RenderError("format must be 0~7".to_string()));
+        }
+        if position > 10 {
+            return Err(HwpError::RenderError("position must be 0~10".to_string()));
+        }
+        let section = self
+            .document
+            .sections
+            .get_mut(section_idx)
+            .ok_or_else(|| HwpError::RenderError("구역 범위 초과".to_string()))?;
+        // Match the upstream getter's last-control rule without relocating any control.
+        let existing = section.paragraphs.iter_mut().rev().find_map(|para| {
+            para.controls.iter_mut().rev().find_map(|control| match control {
+                crate::model::control::Control::PageNumberPos(pnp) => Some(pnp),
+                _ => None,
+            })
+        });
+        let replaced = if let Some(pnp) = existing {
+            pnp.format = format;
+            pnp.position = position;
+            pnp.dash_char = if dash { '-' } else { '\0' };
+            true
+        } else {
+            false
+        };
+        if replaced {
+            self.document.sections[section_idx].raw_stream = None;
+            self.recompose_section(section_idx);
+            self.paginate_if_needed();
+            self.invalidate_page_tree_cache();
+        } else {
+            self.set_page_number_position_native(section_idx, position, format, dash)?;
+        }
+        Ok(format!("{{\"ok\":true,\"replaced\":{replaced}}}"))
+    }
+
+    /// 기존 앱이 읽는 `{ok,pageNumber:{format,position,dash}|null}` 응답.
+    pub fn get_page_number_pos_native(&self, section_idx: usize) -> Result<String, HwpError> {
+        let section = self
+            .document
+            .sections
+            .get(section_idx)
+            .ok_or_else(|| HwpError::RenderError("구역 범위 초과".to_string()))?;
+        Ok(match last_page_number_position(&section.paragraphs) {
+            Some(pnp) => format!(
+                "{{\"ok\":true,\"pageNumber\":{{\"format\":{},\"position\":{},\"dash\":{}}}}}",
+                pnp.format,
+                pnp.position,
+                pnp.dash_char != '\0'
+            ),
+            None => "{\"ok\":true,\"pageNumber\":null}".to_string(),
+        })
+    }
+
     /// 구역의 쪽 번호 매기기(`pgnp`)를 읽는다 (#7635).
     ///
     /// 한/글 쪽 번호 매기기 창처럼 구역 본문 문단의 마지막 쪽 번호 위치를 돌려준다.
diff --git a/src/wasm_api.rs b/src/wasm_api.rs
--- a/src/wasm_api.rs
+++ b/src/wasm_api.rs
@@ -9137,6 +9137,32 @@
             .map_err(|e| e.into())
     }

+    /// 기존 앱 호환: 번호 모양을 위치보다 먼저 받는다 (모양 0~7, 위치 0~10).
+    #[wasm_bindgen(js_name = setPageNumberPos)]
+    pub fn set_page_number_pos(
+        &mut self,
+        section_idx: u32,
+        format: u32,
+        position: u32,
+        dash: bool,
+    ) -> Result<String, JsValue> {
+        if format > 7 {
+            return Err(JsValue::from_str("format must be 0~7"));
+        }
+        if position > 10 {
+            return Err(JsValue::from_str("position must be 0~10"));
+        }
+        self.set_page_number_pos_native(section_idx as usize, format as u8, position as u8, dash)
+            .map_err(|e| e.into())
+    }
+
+    /// 기존 앱 호환: `{ok,pageNumber:{format,position,dash}|null}`.
+    #[wasm_bindgen(js_name = getPageNumberPos)]
+    pub fn get_page_number_pos(&self, section_idx: u32) -> Result<String, JsValue> {
+        self.get_page_number_pos_native(section_idx as usize)
+            .map_err(|e| e.into())
+    }
+
     /// 구역의 쪽 번호 매기기를 정한다 (쪽 > 쪽 번호 매기기, #7635).
     ///
     /// position: 0 없음, 1~3 위 왼쪽·가운데·오른쪽, 4~6 아래, 7·8 바깥쪽 위·아래, 9·10 안쪽 위·아래.
diff --git a/src/wasm_api/tests.rs b/src/wasm_api/tests.rs
--- a/src/wasm_api/tests.rs
+++ b/src/wasm_api/tests.rs
@@ -27073,3 +27073,59 @@
         assert_eq!(info.char_shapes[run.char_shape_id as usize].base_size, 1600);
     }
 }
