{
  "manifest_version": 3,
  "name": "똑딱작업실",
  "short_name": "똑딱작업실",
  "description": "똑딱작업실에서 만든 작업을 학교 업무 사이트에 채워 줍니다. K-에듀파인 품의, 나이스 생기부(세특·행발). 저장과 결재는 선생님이 직접 합니다.",
  "permissions": ["storage", "scripting", "nativeMessaging"],
  "host_permissions": [
    "https://*.go.kr/*",
    "https://hangul-ai-workbench-ehhtyai22q-du.a.run.app/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.go.kr/*"],
      "js": ["page-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://*.go.kr/*"],
      "js": ["page-main.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "똑딱작업실" },
  "externally_connectable": {
    "matches": [
      "https://hangul-ai-workbench-ehhtyai22q-du.a.run.app/*",
      "http://127.0.0.1:5188/*"
    ]
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
